<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <instrumentation
        android:name=".PrivilegedProcess"
        android:targetPackage="${applicationId}" />

    <application
        android:label="Ims"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        tools:ignore="MissingApplicationIcon">

        <provider
            android:name=".ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false" />

        <receiver
            android:name=".ConfigChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SIM_STATE_CHANGED" />
                <action android:name="android.telephony.action.CARRIER_CONFIG_CHANGED" />
                <action android:name="io.github.vvb2060.ims.action.APPLY" />
            </intent-filter>
        </receiver>
    </application>

    <overlay
        android:requiredSystemPropertyName="ro.boot.vbmeta.device_state"
        android:requiredSystemPropertyValue="locked"
        android:targetPackage="${applicationId}" />

</manifest>
